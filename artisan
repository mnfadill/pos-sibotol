#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

if (is_file(__DIR__.DIRECTORY_SEPARATOR.'php.ini')) {
    putenv('PHPRC='.__DIR__);
    $_ENV['PHPRC'] = __DIR__;
    $_SERVER['PHPRC'] = __DIR__;

    if (
        (! extension_loaded('mbstring') || ! extension_loaded('pdo_sqlite'))
        && getenv('POS_ARTISAN_REEXEC') !== '1'
    ) {
        putenv('POS_ARTISAN_REEXEC=1');
        $_ENV['POS_ARTISAN_REEXEC'] = '1';
        $_SERVER['POS_ARTISAN_REEXEC'] = '1';

        $command = array_merge(
            [PHP_BINARY, '-c', __DIR__.DIRECTORY_SEPARATOR.'php.ini', __FILE__],
            array_slice($_SERVER['argv'] ?? [], 1)
        );

        $descriptors = [0 => STDIN, 1 => STDOUT, 2 => STDERR];
        $process = proc_open($command, $descriptors, $pipes, __DIR__);
        if (is_resource($process)) {
            exit(proc_close($process));
        }
    }
}

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
